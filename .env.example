# Staging FastAPI host only (no trailing slash). Example:
# NEXT_PUBLIC_API_BASE_URL=https://your-staging.up.railway.app
# Leave empty to use built-in mock catalog data.
NEXT_PUBLIC_API_BASE_URL=

# Checkout via WhatsApp/Telegram deep link (see app/cart/page.tsx). Leave
# either blank to hide that checkout option. Set at least one to enable
# checkout.
# Digits only, international format, no leading +.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Without the leading @.
NEXT_PUBLIC_TELEGRAM_USERNAME=
